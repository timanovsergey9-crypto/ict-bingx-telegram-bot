# Настройки бота. Перекрывают значения из workflow. Секреты сюда не писать!

# Сканировать ВСЕ пары BingX
TOP_N=0
MIN_QUOTE_VOLUME=500000
SCAN_CONCURRENCY=8

# Лимит сигналов снят
MAX_SIGNALS_PER_DAY=0

# Защита от лавины
MAX_OPEN_TRADES=8
MAX_PER_DIRECTION=4

# Ослаблено под требования: сигналы чаще, не только идеальные
MIN_QUALITY=5.0
MIN_RR=1.6

# Time first
BTC_FILTER=1
KILL_ZONES=London,New York
FORCE_KZ=0
