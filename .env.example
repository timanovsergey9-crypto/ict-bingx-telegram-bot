# Обязательные
TELEGRAM_TOKEN=your_bot_token_from_BotFather
CHAT_ID=your_telegram_chat_or_channel_id

# Основные настройки
HTF=4h
LTF=15m
MARKET_TYPE=swap          # swap = фьючерсы (long+short), spot = только long
TOP_N=20
MIN_QUOTE_VOLUME=5000000  # мин. объём 24ч в USDT
MIN_RR=2.0
MAX_SIGNALS_PER_DAY=2
COOLDOWN_H=4
BTC_FILTER=1              # 1 = фильтровать альты по структуре BTC
KILL_ZONES=London,New York

# ICT параметры (можно не трогать)
# SWING_N=3
# HTF_SWING=3
# SWEEP_LOOKBACK=12
# MSS_WINDOW=6
# MAX_FVG_AGE=8
# DISP_ATR=1.5
# DISP_BODY_RATIO=0.55
# FVG_MIN_ATR=0.3
# STOP_BUFFER_ATR=0.15
# MIN_RISK_ATR=0.5
# MAX_RISK_ATR=5.0
# SETUP_TTL_MIN=240
# TRADE_MAX_HOURS=48
