# Настройки бота. Перекрывают значения из workflow. Секреты сюда не писать!

# Сканировать ВСЕ пары BingX (крипта, акции, индексы — всё, что есть в USDT-перпетуалах)
TOP_N=0                   # 0 = без ограничения числа пар
MIN_QUOTE_VOLUME=500000   # мин. оборот за 24ч в USDT; отсекает «мёртвые» пары с фейковыми свечами
SCAN_CONCURRENCY=8

# Лимит сигналов в сутки снят (0 = без лимита)
MAX_SIGNALS_PER_DAY=0

# Защита от лавины однотипных сигналов (альты ходят вместе с BTC)
MAX_OPEN_TRADES=6         # одновременно открытых сетапов (0 = без лимита)
MAX_PER_DIRECTION=3       # из них не больше 3 в одну сторону

# Строгость сигналов не меняем: именно она отсекает слабые сетапы
MIN_QUALITY=6.5
MIN_RR=2.0
