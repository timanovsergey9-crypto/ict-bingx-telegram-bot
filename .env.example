# ===== Обязательные =====
TELEGRAM_TOKEN=your_bot_token_from_BotFather
CHAT_ID=your_telegram_chat_or_channel_id

# ===== Основные настройки =====
HTF=4h
LTF=15m
MARKET_TYPE=swap              # swap = фьючерсы (long+short), spot = только long

# Скан всего рынка BingX
TOP_N=150                     # сколько пар сканировать (0 = все выше MIN_QUOTE_VOLUME)
MIN_QUOTE_VOLUME=2000000      # мин. 24ч объём в USDT
SCAN_CONCURRENCY=6            # параллельных запросов

MIN_RR=2.0
MAX_SIGNALS_PER_DAY=5
COOLDOWN_H=4
BTC_FILTER=1
KILL_ZONES=London,New York

# ===== Volume / Smart Money =====
REQUIRE_VOLUME_CONFIRM=1
MIN_VOL_RATIO_MSS=1.4
MIN_VOL_RATIO_SWEEP=1.2
ALLOW_LOW_VOL_PRICE_UP=0
LOW_VOL_RATIO=0.7
VOL_SMA_PERIOD=20
