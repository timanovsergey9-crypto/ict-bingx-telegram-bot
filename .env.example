# ===== Обязательные =====
TELEGRAM_TOKEN=your_bot_token_from_BotFather
CHAT_ID=your_telegram_chat_or_channel_id

# ===== Основные настройки =====
HTF=4h
LTF=15m
MARKET_TYPE=swap              # swap = фьючерсы (long+short), spot = только long
TOP_N=100                     # сколько самых ликвидных пар сканировать
MIN_QUOTE_VOLUME=5000000      # мин. 24ч объём в USDT
SCAN_CONCURRENCY=6

# ===== Строгость сигналов =====
MIN_QUALITY=6.5               # 0-10; 6.5 = только грейды A и B (выше = меньше сигналов, но чище)
MIN_RR=2.0
HTF_EMA=50                    # EMA-фильтр тренда на старшем ТФ
MAX_SIGNALS_PER_DAY=4
COOLDOWN_H=6
BTC_FILTER=1
KILL_ZONES=London,New York

# ===== Volume / Smart Money =====
REQUIRE_VOLUME_CONFIRM=1
MIN_VOL_RATIO_MSS=1.4
MIN_VOL_RATIO_SWEEP=1.2
ALLOW_LOW_VOL_PRICE_UP=0
LOW_VOL_RATIO=0.7
VOL_SMA_PERIOD=20

# ===== Только для теста =====
# FORCE_KZ=1                  # игнорировать Kill Zone (для python bot.py --scan-once вне сессий)
